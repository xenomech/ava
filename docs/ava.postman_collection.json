              ],
              "path": [
                "flows",
                "{{flowType}}",
                "steps",
                "invite_team"
              ]
            },
            "description": "Owner or admin only. Every address must already have an account, checked up front rather than failing halfway through the loop. Completing the last step marks the flow completed and empties current_step.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"emails\": [\n      \"bob@example.com\"\n    ],\n    \"role\": \"member\"\n  }\n}",
