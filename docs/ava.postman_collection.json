    {
      "name": "6. Invitations",
      "description": "Accepting an invite is unauthenticated \u2014 the token is the credential. Invite someone from folder 4 first, then read the token out of the database.",
      "item": [
        {
          "name": "Accept invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
