    {
      "name": "4. Tenants",
      "description": "Every route is authenticated and acts on the tenant named in the access token \u2014 the tenant is never addressable through the URL. Invite runs before List members on purpose: listing captures memberUserId for the two requests below it, and you want that to be the invited member rather than the owner (demoting the last owner is a 409).",
      "item": [
        {
          "name": "List my tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenants"
