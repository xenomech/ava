    {
      "name": "2. Sign up and sign in",
      "description": "Run these in order. Register, verify the email (token comes from the database locally), then log in \u2014 the tokens are captured automatically and everything below inherits them.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates the user, their tenant, and an owner membership in one transaction, then emails a verification link.\n\nThe slug must be lowercase alphanumeric words separated by hyphens. Login is blocked until the email is verified.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"username\": \"ada\",\n  \"name\": \"Ada Lovelace\",\n  \"password\": \"supersecret1\",\n  \"phone\": \"+15550000000\",\n  \"tenant_name\": \"Acme\",\n  \"tenant_slug\": \"acme\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 or 409 or 422\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409, 422]);",
                  "});",
                  "(function () {",
                  "    const d = pm.response.json().data;",
                  "    if (d && d.tenant) { pm.collectionVariables.set('tenantSlug', d.tenant.slug); }",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Marks the account verified. Single use \u2014 replaying the token returns 400.\n\nThe token arrives by email. Without a Resend API key nothing is sent, so read it straight from the database:\n\n```\ndocker compose exec -T postgres psql -U ava -d ava_db -tA \\\n  -c \"select token from tokens where type='email_verification' and used_at is null order by created_at desc limit 1\"\n```",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200, 400 or 422\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 422]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "description": "Always answers 200, whether or not the address exists, and issues no new token for an already-verified account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Saves accessToken and refreshToken to collection variables automatically.\n\nA user who belongs to several tenants gets `needs_tenant_selection: true` and a list of choices instead of tokens \u2014 add `\"tenant_slug\": \"{{tenantSlug}}\"` to the body and send again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"supersecret1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 401 or 403\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});",
                  "(function () {",
                  "    const body = pm.response.json();",
                  "    const data = body.data || {};",
                  "    if (data.needs_tenant_selection) {",
                  "        const slugs = (data.tenants || []).map(t => t.slug).join(', ');",
                  "        console.log('Multiple tenants: ' + slugs + ' \u2014 set tenantSlug and send again.');",
                  "    } else if (data.tokens) {",
                  "        pm.collectionVariables.set('accessToken', data.tokens.access_token);",
                  "        pm.collectionVariables.set('refreshToken', data.tokens.refresh_token);",
                  "        if (data.tenant) { pm.collectionVariables.set('tenantSlug', data.tenant.slug); }",
                  "        console.log('Tokens saved.');",
                  "    }",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (choose tenant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Signs in to a named tenant. 403 access_denied if the caller is not a member of it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"supersecret1\",\n  \"tenant_slug\": \"{{tenantSlug}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 401 or 403\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});",
                  "(function () {",
                  "    const body = pm.response.json();",
                  "    const data = body.data || {};",
                  "    if (data.needs_tenant_selection) {",
                  "        const slugs = (data.tenants || []).map(t => t.slug).join(', ');",
                  "        console.log('Multiple tenants: ' + slugs + ' \u2014 set tenantSlug and send again.');",
                  "    } else if (data.tokens) {",
                  "        pm.collectionVariables.set('accessToken', data.tokens.access_token);",
                  "        pm.collectionVariables.set('refreshToken', data.tokens.refresh_token);",
                  "        if (data.tenant) { pm.collectionVariables.set('tenantSlug', data.tenant.slug); }",
                  "        console.log('Tokens saved.');",
                  "    }",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates the pair: the old refresh token dies immediately. Membership is re-read, so a removed member loses access here rather than when the token expires.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 401\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});",
                  "(function () {",
                  "    const data = pm.response.json().data || {};",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set('accessToken', data.access_token);",
                  "        pm.collectionVariables.set('refreshToken', data.refresh_token);",
                  "        console.log('Tokens rotated.');",
                  "    }",
                  "})();"
                ]
              }
            }
          ]
        }
      ]
    },
