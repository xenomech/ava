                ]
              }
            }
          ]
        },
        {
          "name": "Submit step - invite team",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/flows/{{flowType}}/steps/invite_team",
              "host": [
