            "description": "Activates a pending membership.\n\nThe invite token is emailed. Read it from the database with:\n\n```\ndocker compose exec -T postgres psql -U ava -d ava_db -tA \\\n  -c \"select invite_token from tenant_memberships where status='invited' order by created_at desc limit 1\"\n```",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
