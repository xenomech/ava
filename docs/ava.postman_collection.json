    {
      "name": "5. Flows",
      "description": "The onboarding flow engine. One endpoint set serves every registered flow type; steps run in order, so submit profile before workspace before invite team.",
      "item": [
        {
          "name": "Get flow state",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flows/{{flowType}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flows",
                "{{flowType}}"
              ]
            },
            "description": "Returns the caller's flow, creating it on first request \u2014 there is no explicit create endpoint. `metadata` carries the registry's static choices, such as the roles the invite step may offer."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 400 or 401\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401]);",
                  "});",
                  "(function () {",
                  "    const d = pm.response.json().data;",
                  "    if (d && d.current_step) { pm.collectionVariables.set('stepId', d.current_step); }",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit step - profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/flows/{{flowType}}/steps/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flows",
                "{{flowType}}",
                "steps",
                "profile"
              ]
            },
            "description": "Runs the step's side effect \u2014 this one updates the caller's own name and phone.\n\nA validation failure answers 422 with the per-field errors AND the full flow state in `data`, so the client can render them without a second request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"name\": \"Ada Lovelace\",\n    \"phone\": \"+15550000000\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 403 or 409 or 422\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 403, 409, 422]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit step - workspace",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/flows/{{flowType}}/steps/workspace",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flows",
                "{{flowType}}",
                "steps",
                "workspace"
              ]
            },
            "description": "Renames the tenant. Owner or admin only: a member gets 403 step_not_permitted. Because the step is skippable, that member can still finish onboarding by skipping it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"name\": \"Acme Corp\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
