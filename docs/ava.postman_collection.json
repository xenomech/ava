    {
      "name": "7. Password",
      "description": "\u26a0\ufe0f Ordered last on purpose. Change password swaps the password used by the Login request above, and Reset password revokes the caller's sessions in EVERY tenant, so anything after it needs a fresh login.",
      "item": [
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "Requires the current password. Unlike a reset, this does not revoke sessions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"supersecret1\",\n  \"new_password\": \"brandnewpass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
