{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API on this origin so SameSite=Lax cookies attach; `handle` blocks run in source order, so /api is proxied rather than rewritten to index.html.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}
