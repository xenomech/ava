# Hub Configuration
HUB_NAME=
LOG_LEVEL=info
STATE_FILE=avahub-state.json
HEARTBEAT_INTERVAL=60s

# Ava API
API_BASE_URL=http://localhost:8000/api/v1

# MQTT Broker
# Plaintext only reaches a private address; over the internet use wss://host:443 or ssl://host:8883.
MQTT_BROKER_URL=tcp://localhost:1883
# MQTT_CA_FILE=/etc/avahub/broker-ca.pem
# MQTT_ALLOW_INSECURE=true
