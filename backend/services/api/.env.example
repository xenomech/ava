# Application Configuration
PORT=8000
SERVER_ENV=local

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=ava
DB_PASSWORD=ava_password
DB_DATABASE=ava_db

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Hub Activation (RFC 8628 device authorization grant)
DEVICE_CODE_EXPIRY=10m
DEVICE_POLL_INTERVAL=5s
DEVICE_TOKEN_EXPIRY=1h

# Session cookies
# Leave COOKIE_DOMAIN empty for host-only cookies; set it (e.g. .example.com)
# when the API and web app live on different subdomains.
COOKIE_DOMAIN=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-User-ID,X-Tenant-ID,X-REQUEST-ID,X-TIME,X-Device-Name
CORS_MAX_AGE=86400

# Email Configuration (Resend)
# RESEND_FROM_EMAIL must sit on a domain verified in your Resend account,
# otherwise every send is rejected.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=Ava
APP_URL=http://localhost:3000

# MQTT
MQTT_PORT=1893
MQTT_USERNAME=ava-api
MQTT_PASSWORD=change-me
# Plaintext is accepted only to a private address; a public host needs wss:// or ssl://.
MQTT_BROKER_URL=tcp://localhost:1893
# MQTT_CA_FILE=/etc/ssl/certs/broker-ca.pem
# MQTT_ALLOW_INSECURE=true
